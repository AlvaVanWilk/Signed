# Wenn das ganze Projekt in einem Ordner auf dem Webspace liegt (z. B. /signed):
# Alle Aufrufe gehen in public/. So bleiben src/, data/ und config.php von außen unerreichbar.
RewriteEngine On

# Basispfad dieses Ordners ermitteln (z. B. /signed-test/), damit die Regel in jedem Ordner funktioniert.
RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
RewriteRule ^(.*)$ - [E=SIGNED_BASE:%1]

RewriteRule ^(?!public/)(.*)$ %{ENV:SIGNED_BASE}public/$1 [L]

<Files "config.php">
  Require all denied
</Files>
